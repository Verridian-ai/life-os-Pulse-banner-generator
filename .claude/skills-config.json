{
  "version": "2.0.0",
  "last_updated": "2026-01-13",
  "description": "Skills configuration with Task tool subagent_type mappings",
  "orchestrator": {
    "enabled": true,
    "auto_delegate": true,
    "mandatory_delegation": true,
    "direct_execution_forbidden": true,
    "ask_approval_for_opus": true,
    "cost_threshold_for_approval": 1.0,
    "ralph_loop": {
      "enabled": true,
      "default_max_iterations": 50,
      "auto_delegate_subtasks": true,
      "persist_progress": true,
      "airlock_validation": {
        "enabled": true,
        "gates": [
          {
            "name": "TypeScript",
            "command": "npx tsc --noEmit",
            "required": true
          },
          {
            "name": "ESLint",
            "command": "npx eslint .",
            "required": true
          },
          {
            "name": "Tests",
            "command": "npm test",
            "required": false
          },
          {
            "name": "Build",
            "command": "npm run build",
            "required": true
          }
        ],
        "on_failure": "retry_in_agent_context",
        "max_retries": 3
      },
      "state_file": ".claude/ralph-loop.local.md",
      "commit_after_iteration": true,
      "conventional_commits": true,
      "cost_tracking": {
        "enabled": true,
        "warn_at_cost_usd": 25.0,
        "stop_at_cost_usd": 100.0
      }
    }
  },
