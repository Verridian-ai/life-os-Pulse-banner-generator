    "orchestrator_allowed_tools": [
      "TodoWrite",
      "AskUserQuestion",
      "Task"
    ],
    "orchestrator_forbidden_tools": [
      "Read", "Write", "Edit", "Grep", "Glob", "Bash",
      "NeonManager", "Supabase", "ChromeDevTools"
    ],
    "bypass_isolation": [
      "Context7",
      "WebSearch"
    ],
    "require_approval": [
      "Write",
      "Bash(rm)",
      "Bash(deploy)",
      "Supabase(migrate)"
