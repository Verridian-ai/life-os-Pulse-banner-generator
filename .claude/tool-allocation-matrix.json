{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0.0",
  "description": "MCP Tool Allocation Matrix - Maps tools to skill agents with mandatory delegation enforcement",
  "last_updated": "2026-01-13",

  "mandatory_delegation": {
    "enabled": true,
    "description": "The orchestrator MUST delegate ALL tasks to specialized agents via the Task tool",
    "orchestrator_allowed_actions": [
      "Classify user request",
      "Select appropriate agent",
      "Invoke Task tool with subagent_type",
      "Present results to user",
      "Use TodoWrite for planning",
      "Use AskUserQuestion for clarification"
    ],
    "orchestrator_forbidden_actions": [
      "Execute Read/Write/Edit tools directly",
      "Execute Grep/Glob tools directly",
      "Execute Bash commands directly",
      "Handle any task without delegation"
    ]
  },

  "subagent_type_mapping": {
    "description": "Maps skill names to Task tool subagent_type values",
    "mappings": {
      "research-agent": "Research Agent",
      "quick-tasks-agent": "Quick Tasks Agent",
      "coding-agent": "Coding Agent",
      "refactoring-agent": "Refactoring Agent",
      "debugging-agent": "Debugging Agent",
      "decision-agent": "Decision Agent",
      "codebase-organization-agent": "Codebase Organization Agent",
      "skill-creator-agent": "Skill Creator Agent",
      "chrome-ui-browser-agent": "Chrome UI Browser Agent",
      "cognee-memory-agent": "Cognee Memory Agent",
      "database-agent": "Neon Manager",
      "neon-manager": "Neon Manager",
      "workos-config-agent": "WorkOS Config Agent",
      "cloud-run-manager": "Cloud Run Manager",
      "gcloud-services": "Google Cloud Services",
      "depth-ui-engineer": "Depth UI Engineer",
      "code-standards-auditor": "Code Standards Auditor",
      "ux-heatmap-analyst": "UX Heatmap Analyst",
      "security-auditor-agent": "Security Auditor Agent",
      "security-agent": "Security Auditor Agent",
      "architecture-analyzer-agent": "Architecture Analyzer Agent",
      "architecture-agent": "Architecture Analyzer Agent",
    "test-generator-agent": "Test Generator Agent",
      "test-agent": "Test Generator Agent",
      "performance-profiler-agent": "Performance Profiler Agent",
      "performance-agent": "Performance Profiler Agent",
      "deep-research-agent": "general-purpose",
      "web-search-agent": "general-purpose",
      "openrouter-deep-research-agent": "general-purpose"
    }
  },

  "tool_categories": {
    "code_search": {
      "tools": ["Grep", "Glob", "Serena"],
      "assigned_skills": ["research-agent"],
      "context_impact": "low",
      "isolation_required": true
    },
    "code_modification": {
      "tools": ["Read", "Edit", "Write"],
      "assigned_skills": ["coding-agent", "quick-tasks-agent", "codebase-organization-agent"],
      "context_impact": "medium",
      "isolation_required": true
    },
    "testing": {
      "tools": ["Bash(test)", "Vitest", "Playwright"],
      "assigned_skills": ["qa-agent"],
      "context_impact": "high",
      "isolation_required": true
    },
    "database": {
      "tools": ["NeonManager", "Supabase", "Postgres"],
      "assigned_skills": ["database-agent"],
      "context_impact": "medium",
      "isolation_required": true
    },
    "security": {
      "tools": ["Semgrep", "OSVScanner", "Bash(audit)"],
      "assigned_skills": ["security-agent"],
      "context_impact": "high",
      "isolation_required": true
    },
    "linting": {
      "tools": ["ESLint", "TypeScript", "Prettier"],
      "assigned_skills": ["quick-tasks-agent", "codebase-organization-agent"],
      "context_impact": "low",
      "isolation_required": false
    },
    "performance": {
      "tools": ["ChromeDevTools", "Lighthouse"],
      "assigned_skills": ["chrome-ui-browser-agent", "debugging-agent"],
      "context_impact": "very_high",
      "isolation_required": true
    },
    "git": {
      "tools": ["GitHub", "ConventionalCommits"],
      "assigned_skills": ["release-agent"],
      "context_impact": "medium",
      "isolation_required": false
    },
    "ai_observability": {
      "tools": ["Langfuse", "Guardrails"],
      "assigned_skills": ["observability-agent", "safety-agent"],
      "context_impact": "medium",
      "isolation_required": true
    },
    "documentation": {
      "tools": ["Context7", "WebSearch", "WebFetch"],
      "assigned_skills": ["research-agent"],
      "context_impact": "low",
      "isolation_required": false
    },
    "autonomous_execution": {
      "tools": ["RalphLoop"],
      "assigned_skills": ["orchestrator", "coding-agent"],
      "context_impact": "very_high",
      "isolation_required": false
    },
    "governance_hooks": {
      "tools": ["Hookify"],
      "assigned_skills": ["orchestrator", "codebase-organization-agent"],
      "context_impact": "low",
      "isolation_required": false
    },
    "memory_system": {
      "tools": ["Cognee"],
      "assigned_skills": ["ALL"],
      "context_impact": "medium",
      "isolation_required": true
    }
  },

