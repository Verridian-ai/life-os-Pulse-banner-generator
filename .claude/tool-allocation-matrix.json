  "routing_rules": {
    "default_behavior": "delegate_to_skill",
    "orchestrator_overrides": [
      "TodoWrite",
      "AskUserQuestion",
      "Skill"
    ],
    "bypass_isolation": [
      "Context7",
      "WebSearch"
    ],
    "require_approval": [
      "Write",
      "Bash(rm)",
      "Bash(deploy)",
      "Supabase(migrate)"
    ]
  },

  "context_budgets": {
    "daily_total": 200000,
    "orchestrator_max": 5000,
    "per_skill_defaults": {
      "haiku": 20000,
      "sonnet": 50000,
      "opus": 20000
    },
    "alert_threshold": 0.8
  },

  "isolation_config": {
    "method": "subprocess",
    "timeout_ms": 300000,
    "max_concurrent_skills": 5,
    "cleanup_after_execution": true,
    "share_context_between_skills": false
  }
}
