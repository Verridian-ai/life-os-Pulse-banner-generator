
# Ignore node_modules since Docker will install dependencies
node_modules/

# Git files
.git/
.gitignore

# Development files
*.log
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build output (will be created in Docker)
dist/

# Test files
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# Documentation that's not needed in production
*.md
!README.md

# Local development files
.worktrees/
.claude/
docs/
scripts/

# Vercel files
.vercel/
vercel.json

# Other
.DS_Store
Thumbs.db
nul
deploy_output*.txt

# Browser test files
browser-test*
playwright*

# Config files not needed for build
.lighthouserc*
.mcp.json
.size-limit.json

# PowerShell Source (Unrelated large directory)
PowerShell-Source/
ui-inspection/
test-screenshots/
screenshots/

# Large asset files not needed for build
public/assets/templates/*.mp4
public/assets/templates/*.zip
public/assets/templates/*.pdf
public/assets/templates/*.psd
public/assets/templates/*.ai
public/assets/templates/*.eps
public/assets/templates/logo_packs/
public/assets/templates/GitHub-Logos/
public/assets/templates/company_logos/

# Python cache
__pycache__/
*.pyc
*.pyo
cognee_agents/__pycache__/
cognee_agents/**/__pycache__/

# Temporary files
*.tmp
*.temp

# Auto-claude deprecated files
.auto-claude/
