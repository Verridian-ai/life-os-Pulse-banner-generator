{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Signal Colors - Anti-Slop Compliant",
  "description": "Award-winning palette avoiding generic AI aesthetics (teal, purple)",

  "antiSlop": {
    "banned": ["#14B8A6", "#A020F0", "#8B5CF6"],
    "bannedNames": ["teal-500", "purple-500", "violet-500"],
    "reason": "Algorithmic Teal and AI Purple are overused in AI-generated designs"
  },

  "primary": {
    "50": "#fff7ed",
    "100": "#ffedd5",
    "200": "#fed7aa",
    "300": "#fdba74",
    "400": "#fb923c",
    "500": "#f97316",
    "600": "#ea580c",
    "700": "#c2410c",
    "800": "#9a3412",
    "900": "#7c2d12",
    "950": "#431407",
    "name": "orange",
    "description": "Warm, energetic primary - distinctive from AI defaults"
  },

  "accent": {
    "50": "#ecfdf5",
    "100": "#d1fae5",
    "200": "#a7f3d0",
    "300": "#6ee7b7",
    "400": "#34d399",
    "500": "#10b981",
    "600": "#059669",
    "700": "#047857",
    "800": "#065f46",
    "900": "#064e3b",
    "950": "#022c22",
    "name": "emerald",
    "description": "Natural green accent - distinct from algorithmic teal"
  },

  "neutral": {
    "50": "#fafaf9",
    "100": "#f5f5f4",
    "200": "#e7e5e4",
    "300": "#d6d3d1",
    "400": "#a8a29e",
    "500": "#78716c",
    "600": "#57534e",
    "700": "#44403c",
    "800": "#292524",
    "900": "#1c1917",
    "950": "#0c0a09",
    "name": "stone",
    "description": "Warm neutrals for sophisticated dark mode"
  },

  "semantic": {
    "success": "#22c55e",
    "warning": "#f59e0b",
    "error": "#ef4444",
    "info": "#3b82f6"
  },

  "gradient": {
    "primary": "linear-gradient(135deg, #f97316 0%, #ea580c 100%)",
    "accent": "linear-gradient(135deg, #10b981 0%, #059669 100%)",
    "warm": "linear-gradient(135deg, #f97316 0%, #f59e0b 100%)",
    "cool": "linear-gradient(135deg, #10b981 0%, #3b82f6 100%)",
    "premium": "linear-gradient(135deg, #f97316 0%, #ec4899 100%)",
    "dark": "linear-gradient(135deg, #1c1917 0%, #292524 100%)"
  },

  "glow": {
    "primary": "0 0 40px rgba(249, 115, 22, 0.3)",
    "accent": "0 0 40px rgba(16, 185, 129, 0.3)",
    "warm": "0 0 40px rgba(245, 158, 11, 0.3)"
  }
}
