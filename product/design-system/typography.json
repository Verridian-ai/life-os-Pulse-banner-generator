{
  "meta": {
    "name": "Signal Design System — Typography",
    "version": "1.0.0",
    "description": "Typography tokens for Signal",
    "philosophy": "Bold, distinctive type that commands attention"
  },

  "antiSlop": {
    "description": "Fonts explicitly banned to avoid AI clichés",
    "banned": [
      {
        "name": "Inter",
        "reason": "Default AI font, used by every generic AI tool"
      },
      {
        "name": "SF Pro",
        "reason": "Apple system font, makes products feel like iOS clones"
      },
      {
        "name": "Roboto",
        "reason": "Google default, signals no design thought"
      }
    ]
  },

  "fontFamilies": {
    "heading": {
      "name": "Space Grotesk",
      "fallback": "system-ui, sans-serif",
      "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "usage": "Headings, display text, navigation labels, buttons"
    },
    "body": {
      "name": "system-ui",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "googleFontsUrl": null,
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600
      },
      "usage": "Body text, descriptions, form inputs"
    },
    "mono": {
      "name": "IBM Plex Mono",
      "fallback": "ui-monospace, monospace",
      "googleFontsUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap",
      "weights": {
        "regular": 400,
        "medium": 500
      },
      "usage": "Code, technical values, keyboard shortcuts"
    }
  },

  "scale": {
    "display": {
      "fontSize": "3rem",
      "lineHeight": 1.1,
      "fontWeight": 700,
      "letterSpacing": "-0.02em",
      "fontFamily": "heading"
    },
    "h1": {
      "fontSize": "2.25rem",
      "lineHeight": 1.2,
      "fontWeight": 700,
      "letterSpacing": "-0.01em",
      "fontFamily": "heading"
    },
    "h2": {
      "fontSize": "1.875rem",
      "lineHeight": 1.25,
      "fontWeight": 600,
      "letterSpacing": "-0.01em",
      "fontFamily": "heading"
    },
    "h3": {
      "fontSize": "1.5rem",
      "lineHeight": 1.3,
      "fontWeight": 600,
      "letterSpacing": "0",
      "fontFamily": "heading"
    },
    "h4": {
      "fontSize": "1.25rem",
      "lineHeight": 1.4,
      "fontWeight": 600,
      "letterSpacing": "0",
      "fontFamily": "heading"
    },
    "body-lg": {
      "fontSize": "1.125rem",
      "lineHeight": 1.6,
      "fontWeight": 400,
      "letterSpacing": "0",
      "fontFamily": "body"
    },
    "body": {
      "fontSize": "1rem",
      "lineHeight": 1.6,
      "fontWeight": 400,
      "letterSpacing": "0",
      "fontFamily": "body"
    },
    "body-sm": {
      "fontSize": "0.875rem",
      "lineHeight": 1.5,
      "fontWeight": 400,
      "letterSpacing": "0",
      "fontFamily": "body"
    },
    "caption": {
      "fontSize": "0.75rem",
      "lineHeight": 1.4,
      "fontWeight": 500,
      "letterSpacing": "0.01em",
      "fontFamily": "body"
    },
    "overline": {
      "fontSize": "0.625rem",
      "lineHeight": 1.2,
      "fontWeight": 700,
      "letterSpacing": "0.1em",
      "textTransform": "uppercase",
      "fontFamily": "heading"
    }
  },

  "navigation": {
    "sidebar": {
      "fontSize": "0.875rem",
      "fontWeight": 500,
      "letterSpacing": "0",
      "fontFamily": "heading"
    },
    "bottomNav": {
      "fontSize": "0.625rem",
      "fontWeight": 600,
      "letterSpacing": "0.05em",
      "textTransform": "uppercase",
      "fontFamily": "heading"
    },
    "button": {
      "fontSize": "0.75rem",
      "fontWeight": 700,
      "letterSpacing": "0.05em",
      "textTransform": "uppercase",
      "fontFamily": "heading"
    }
  }
}
