# Pydantic AI Agent Service Configuration

# Service Settings
AGENT_SERVICE_NAME=nanobanna-agent-service
AGENT_ENVIRONMENT=development
AGENT_DEBUG=true
AGENT_PORT=8001

# LLM Configuration
AGENT_OPENROUTER_API_KEY=sk-or-v1-xxxxx
AGENT_OPENAI_API_KEY=sk-xxxxx
AGENT_ANTHROPIC_API_KEY=sk-ant-xxxxx
AGENT_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

# Cognee Memory Settings
AGENT_COGNEE_API_URL=https://cognee-api-ypjes2hexa-uc.a.run.app
AGENT_COGNEE_API_KEY=your-cognee-api-key
AGENT_MEMORY_ENABLED=true

# Langfuse Observability
AGENT_LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
AGENT_LANGFUSE_SECRET_KEY=sk-lf-xxxxx
AGENT_LANGFUSE_HOST=https://cloud.langfuse.com
AGENT_TRACING_ENABLED=true

# Agent Limits
AGENT_MAX_CONCURRENT_AGENTS=5
AGENT_AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_MEMORY_CONTEXT_TOKENS=4000
