# LOCAL COGNEE MEMORY SYSTEM - Environment Variables Template
# This is for running Cognee locally on your Windows PC via Docker Desktop
# Used ONLY by docker-compose.cognee.yml
# NOT related to the production Nanobanna Pro backend

# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.cognee.template .env.cognee.local
# 2. Fill in the passwords below
# 3. The OpenAI key is already set in .env.cognee (gitignored)

# OpenAI API Key (for Cognee's embeddings and LLM operations)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# LLM Model Configuration (GPT-5.2 - Latest as of January 2026)
# GPT-5.2 features: 400K context window, 93.2% GPQA Diamond, 100% AIME 2025
LLM_MODEL=gpt-5.2
# Fallback to GPT-4-turbo if GPT-5.2 not available
LLM_FALLBACK_MODEL=gpt-4-turbo

# Embedding Model (for vector search)
# text-embedding-3-small - Best balance of cost/performance
# Cost: $0.02 per 1M tokens (vs $0.13 for large)
# Dimensions: 1536 (same as Ada-002)
EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Graph Database Password (local only)
# Set a secure password for your local Neo4j instance
NEO4J_PASSWORD=local_dev_password_change_me

# PostgreSQL Password (local only)
# Set a secure password for your local PostgreSQL instance
POSTGRES_PASSWORD=local_postgres_password_change_me

# Cognee API Key (optional, for authentication)
# Leave empty for local development without auth
COGNEE_API_KEY=

# Note: These credentials are ONLY for your local Docker containers
# They are NOT used by the Nanobanna Pro production system
